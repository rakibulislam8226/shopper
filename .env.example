# ---- App --------------------------------------------------------------------
APP_ENV=development
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database (Postgres) ----------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth (wired in Phase 2) ------------------------------------------------
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_DAYS=7
JWT_REFRESH_EXPIRES_DAYS=10

# ---- Media Storage ----------------------------------------------------------
MEDIA_STORAGE_DRIVER=local          # local | s3
MEDIA_LOCAL_UPLOAD_DIR=./media
MEDIA_LOCAL_BASE_URL=http://localhost:8000/media
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BASE_URL=

# ---- Rate limiting (wired in later phases) ----------------------------------
RATE_LIMIT_TIMES=20
RATE_LIMIT_SECONDS=60

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=debug

